rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hash(value) {
      return hashing.sha256(value).toHexString().lower();
    }
    
    // Rules lower() folds ASCII only; explicitly cover Vietnamese and Latin-1.
    function legacyNameKey(value) {
      return trimName(value).lower()
        .replace('À', 'à')
        .replace('Á', 'á')
        .replace('Â', 'â')
        .replace('Ã', 'ã')
        .replace('Ä', 'ä')
        .replace('Å', 'å')
        .replace('Æ', 'æ')
        .replace('Ç', 'ç')
        .replace('È', 'è')
        .replace('É', 'é')
        .replace('Ê', 'ê')
        .replace('Ë', 'ë')
        .replace('Ì', 'ì')
        .replace('Í', 'í')
        .replace('Î', 'î')
        .replace('Ï', 'ï')
        .replace('Ð', 'ð')
        .replace('Ñ', 'ñ')
        .replace('Ò', 'ò')
        .replace('Ó', 'ó')
        .replace('Ô', 'ô')
        .replace('Õ', 'õ')
        .replace('Ö', 'ö')
        .replace('Ø', 'ø')
        .replace('Ù', 'ù')
        .replace('Ú', 'ú')
        .replace('Û', 'û')
        .replace('Ü', 'ü')
        .replace('Ý', 'ý')
        .replace('Þ', 'þ')
        .replace('Ă', 'ă')
        .replace('Đ', 'đ')
        .replace('Ĩ', 'ĩ')
        .replace('Ũ', 'ũ')
        .replace('Ơ', 'ơ')
        .replace('Ư', 'ư')
        .replace('Ÿ', 'ÿ')
        .replace('Ạ', 'ạ')
        .replace('Ả', 'ả')
        .replace('Ấ', 'ấ')
        .replace('Ầ', 'ầ')
        .replace('Ẩ', 'ẩ')
        .replace('Ẫ', 'ẫ')
        .replace('Ậ', 'ậ')
        .replace('Ắ', 'ắ')
        .replace('Ằ', 'ằ')
        .replace('Ẳ', 'ẳ')
        .replace('Ẵ', 'ẵ')
        .replace('Ặ', 'ặ')
        .replace('Ẹ', 'ẹ')
        .replace('Ẻ', 'ẻ')
        .replace('Ẽ', 'ẽ')
        .replace('Ế', 'ế')
        .replace('Ề', 'ề')
        .replace('Ể', 'ể')
        .replace('Ễ', 'ễ')
        .replace('Ệ', 'ệ')
        .replace('Ỉ', 'ỉ')
        .replace('Ị', 'ị')
        .replace('Ọ', 'ọ')
        .replace('Ỏ', 'ỏ')
        .replace('Ố', 'ố')
        .replace('Ồ', 'ồ')
        .replace('Ổ', 'ổ')
        .replace('Ỗ', 'ỗ')
        .replace('Ộ', 'ộ')
        .replace('Ớ', 'ớ')
        .replace('Ờ', 'ờ')
        .replace('Ở', 'ở')
        .replace('Ỡ', 'ỡ')
        .replace('Ợ', 'ợ')
        .replace('Ụ', 'ụ')
        .replace('Ủ', 'ủ')
        .replace('Ứ', 'ứ')
        .replace('Ừ', 'ừ')
        .replace('Ử', 'ử')
        .replace('Ữ', 'ữ')
        .replace('Ự', 'ự')
        .replace('Ỳ', 'ỳ')
        .replace('Ỵ', 'ỵ')
        .replace('Ỷ', 'ỷ')
        .replace('Ỹ', 'ỹ');
    }


    function trimName(value) {
      return value.replace(
        '^[\\p{Z}\\x{9}-\\x{D}\\x{85}\\x{FEFF}]+|[\\p{Z}\\x{9}-\\x{D}\\x{85}\\x{FEFF}]+$',
        ''
      );
    }

    // Unicode 17.0 CaseFolding.txt (https://www.unicode.org/license.txt).
    // Apply expansions and RE2 compatibility mappings before caseless comparison.
    function expandFullFolds(value) {
      return value
        .replace('[\\x{DF}\\x{1E9E}]', 'ss')
        .replace('[\\x{130}]', 'i̇')
        .replace('[\\x{149}]', 'ʼn')
        .replace('[\\x{1F0}]', 'ǰ')
        .replace('[\\x{390}\\x{1FD3}]', 'ΐ')
        .replace('[\\x{3B0}\\x{1FE3}]', 'ΰ')
        .replace('[\\x{587}]', 'եւ')
        .replace('[\\x{1E96}]', 'ẖ')
        .replace('[\\x{1E97}]', 'ẗ')
        .replace('[\\x{1E98}]', 'ẘ')
        .replace('[\\x{1E99}]', 'ẙ')
        .replace('[\\x{1E9A}]', 'aʾ')
        .replace('[\\x{1F50}]', 'ὐ')
        .replace('[\\x{1F52}]', 'ὒ')
        .replace('[\\x{1F54}]', 'ὔ')
        .replace('[\\x{1F56}]', 'ὖ')
        .replace('[\\x{1F80}\\x{1F88}]', 'ἀι')
        .replace('[\\x{1F81}\\x{1F89}]', 'ἁι')
        .replace('[\\x{1F82}\\x{1F8A}]', 'ἂι')
        .replace('[\\x{1F83}\\x{1F8B}]', 'ἃι')
        .replace('[\\x{1F84}\\x{1F8C}]', 'ἄι')
        .replace('[\\x{1F85}\\x{1F8D}]', 'ἅι')
        .replace('[\\x{1F86}\\x{1F8E}]', 'ἆι')
        .replace('[\\x{1F87}\\x{1F8F}]', 'ἇι')
        .replace('[\\x{1F90}\\x{1F98}]', 'ἠι')
        .replace('[\\x{1F91}\\x{1F99}]', 'ἡι')
        .replace('[\\x{1F92}\\x{1F9A}]', 'ἢι')
        .replace('[\\x{1F93}\\x{1F9B}]', 'ἣι')
        .replace('[\\x{1F94}\\x{1F9C}]', 'ἤι')
        .replace('[\\x{1F95}\\x{1F9D}]', 'ἥι')
        .replace('[\\x{1F96}\\x{1F9E}]', 'ἦι')
        .replace('[\\x{1F97}\\x{1F9F}]', 'ἧι')
        .replace('[\\x{1FA0}\\x{1FA8}]', 'ὠι')
        .replace('[\\x{1FA1}\\x{1FA9}]', 'ὡι')
        .replace('[\\x{1FA2}\\x{1FAA}]', 'ὢι')
        .replace('[\\x{1FA3}\\x{1FAB}]', 'ὣι')
        .replace('[\\x{1FA4}\\x{1FAC}]', 'ὤι')
        .replace('[\\x{1FA5}\\x{1FAD}]', 'ὥι')
        .replace('[\\x{1FA6}\\x{1FAE}]', 'ὦι')
        .replace('[\\x{1FA7}\\x{1FAF}]', 'ὧι')
        .replace('[\\x{1FB2}]', 'ὰι')
        .replace('[\\x{1FB3}\\x{1FBC}]', 'αι')
        .replace('[\\x{1FB4}]', 'άι')
        .replace('[\\x{1FB6}]', 'ᾶ')
        .replace('[\\x{1FB7}]', 'ᾶι')
        .replace('[\\x{1FC2}]', 'ὴι')
        .replace('[\\x{1FC3}\\x{1FCC}]', 'ηι')
        .replace('[\\x{1FC4}]', 'ήι')
        .replace('[\\x{1FC6}]', 'ῆ')
        .replace('[\\x{1FC7}]', 'ῆι')
        .replace('[\\x{1FD2}]', 'ῒ')
        .replace('[\\x{1FD6}]', 'ῖ')
        .replace('[\\x{1FD7}]', 'ῗ')
        .replace('[\\x{1FE2}]', 'ῢ')
        .replace('[\\x{1FE4}]', 'ῤ')
        .replace('[\\x{1FE6}]', 'ῦ')
        .replace('[\\x{1FE7}]', 'ῧ')
        .replace('[\\x{1FF2}]', 'ὼι')
        .replace('[\\x{1FF3}\\x{1FFC}]', 'ωι')
        .replace('[\\x{1FF4}]', 'ώι')
        .replace('[\\x{1FF6}]', 'ῶ')
        .replace('[\\x{1FF7}]', 'ῶι')
        .replace('[\\x{FB00}]', 'ff')
        .replace('[\\x{FB01}]', 'fi')
        .replace('[\\x{FB02}]', 'fl')
        .replace('[\\x{FB03}]', 'ffi')
        .replace('[\\x{FB04}]', 'ffl')
        .replace('[\\x{FB05}-\\x{FB06}]', 'st')
        .replace('[\\x{FB13}]', 'մն')
        .replace('[\\x{FB14}]', 'մե')
        .replace('[\\x{FB15}]', 'մի')
        .replace('[\\x{FB16}]', 'վն')
        .replace('[\\x{FB17}]', 'մխ')
        .replace('[\\x{1C80}]', 'в')
        .replace('[\\x{1C81}]', 'д')
        .replace('[\\x{1C82}]', 'о')
        .replace('[\\x{1C83}]', 'с')
        .replace('[\\x{1C84}-\\x{1C85}]', 'т')
        .replace('[\\x{1C86}]', 'ъ')
        .replace('[\\x{1C87}]', 'ѣ')
        .replace('[\\x{1C88}]', 'ꙋ')
        .replace('[\\x{A7CE}]', '꟏')
        .replace('[\\x{A7D2}]', 'ꟓ')
        .replace('[\\x{A7D4}]', 'ꟕ')
        .replace('[\\x{16EA0}]', '𖺻')
        .replace('[\\x{16EA1}]', '𖺼')
        .replace('[\\x{16EA2}]', '𖺽')
        .replace('[\\x{16EA3}]', '𖺾')
        .replace('[\\x{16EA4}]', '𖺿')
        .replace('[\\x{16EA5}]', '𖻀')
        .replace('[\\x{16EA6}]', '𖻁')
        .replace('[\\x{16EA7}]', '𖻂')
        .replace('[\\x{16EA8}]', '𖻃')
        .replace('[\\x{16EA9}]', '𖻄')
        .replace('[\\x{16EAA}]', '𖻅')
        .replace('[\\x{16EAB}]', '𖻆')
        .replace('[\\x{16EAC}]', '𖻇')
        .replace('[\\x{16EAD}]', '𖻈')
        .replace('[\\x{16EAE}]', '𖻉')
        .replace('[\\x{16EAF}]', '𖻊')
        .replace('[\\x{16EB0}]', '𖻋')
        .replace('[\\x{16EB1}]', '𖻌')
        .replace('[\\x{16EB2}]', '𖻍')
        .replace('[\\x{16EB3}]', '𖻎')
        .replace('[\\x{16EB4}]', '𖻏')
        .replace('[\\x{16EB5}]', '𖻐')
        .replace('[\\x{16EB6}]', '𖻑')
        .replace('[\\x{16EB7}]', '𖻒')
        .replace('[\\x{16EB8}]', '𖻓');
    }

    function validNameKey(name, key) {
      // The canonical key excludes every fold source, including ASCII E.
      // That makes \Q...\E safe even when the name contains regex punctuation.
      return key is string && key.matches('(?s).{1,240}')
        && !key.matches('(?s).*[\\x{41}-\\x{5A}\\x{B5}\\x{C0}-\\x{D6}\\x{D8}-\\x{DF}\\x{100}\\x{102}\\x{104}\\x{106}\\x{108}\\x{10A}\\x{10C}\\x{10E}\\x{110}\\x{112}\\x{114}\\x{116}\\x{118}\\x{11A}\\x{11C}\\x{11E}\\x{120}\\x{122}\\x{124}\\x{126}\\x{128}\\x{12A}\\x{12C}\\x{12E}\\x{130}\\x{132}\\x{134}\\x{136}\\x{139}\\x{13B}\\x{13D}\\x{13F}\\x{141}\\x{143}\\x{145}\\x{147}\\x{149}-\\x{14A}\\x{14C}\\x{14E}\\x{150}\\x{152}\\x{154}\\x{156}\\x{158}\\x{15A}\\x{15C}\\x{15E}\\x{160}\\x{162}\\x{164}\\x{166}\\x{168}\\x{16A}\\x{16C}\\x{16E}\\x{170}\\x{172}\\x{174}\\x{176}\\x{178}-\\x{179}\\x{17B}\\x{17D}\\x{17F}\\x{181}-\\x{182}\\x{184}\\x{186}-\\x{187}\\x{189}-\\x{18B}\\x{18E}-\\x{191}\\x{193}-\\x{194}\\x{196}-\\x{198}\\x{19C}-\\x{19D}\\x{19F}-\\x{1A0}\\x{1A2}\\x{1A4}\\x{1A6}-\\x{1A7}\\x{1A9}\\x{1AC}\\x{1AE}-\\x{1AF}\\x{1B1}-\\x{1B3}\\x{1B5}\\x{1B7}-\\x{1B8}\\x{1BC}\\x{1C4}-\\x{1C5}\\x{1C7}-\\x{1C8}\\x{1CA}-\\x{1CB}\\x{1CD}\\x{1CF}\\x{1D1}\\x{1D3}\\x{1D5}\\x{1D7}\\x{1D9}\\x{1DB}\\x{1DE}\\x{1E0}\\x{1E2}\\x{1E4}\\x{1E6}\\x{1E8}\\x{1EA}\\x{1EC}\\x{1EE}\\x{1F0}-\\x{1F2}\\x{1F4}\\x{1F6}-\\x{1F8}\\x{1FA}\\x{1FC}\\x{1FE}\\x{200}\\x{202}\\x{204}\\x{206}\\x{208}\\x{20A}\\x{20C}\\x{20E}\\x{210}\\x{212}\\x{214}\\x{216}\\x{218}\\x{21A}\\x{21C}\\x{21E}\\x{220}\\x{222}\\x{224}\\x{226}\\x{228}\\x{22A}\\x{22C}\\x{22E}\\x{230}\\x{232}\\x{23A}-\\x{23B}\\x{23D}-\\x{23E}\\x{241}\\x{243}-\\x{246}\\x{248}\\x{24A}\\x{24C}\\x{24E}\\x{345}\\x{370}\\x{372}\\x{376}\\x{37F}\\x{386}\\x{388}-\\x{38A}\\x{38C}\\x{38E}-\\x{3A1}\\x{3A3}-\\x{3AB}\\x{3B0}\\x{3C2}\\x{3CF}-\\x{3D1}\\x{3D5}-\\x{3D6}\\x{3D8}\\x{3DA}\\x{3DC}\\x{3DE}\\x{3E0}\\x{3E2}\\x{3E4}\\x{3E6}\\x{3E8}\\x{3EA}\\x{3EC}\\x{3EE}\\x{3F0}-\\x{3F1}\\x{3F4}-\\x{3F5}\\x{3F7}\\x{3F9}-\\x{3FA}\\x{3FD}-\\x{42F}\\x{460}\\x{462}\\x{464}\\x{466}\\x{468}\\x{46A}\\x{46C}\\x{46E}\\x{470}\\x{472}\\x{474}\\x{476}\\x{478}\\x{47A}\\x{47C}\\x{47E}\\x{480}\\x{48A}\\x{48C}\\x{48E}\\x{490}\\x{492}\\x{494}\\x{496}\\x{498}\\x{49A}\\x{49C}\\x{49E}\\x{4A0}\\x{4A2}\\x{4A4}\\x{4A6}\\x{4A8}\\x{4AA}\\x{4AC}\\x{4AE}\\x{4B0}\\x{4B2}\\x{4B4}\\x{4B6}\\x{4B8}\\x{4BA}\\x{4BC}\\x{4BE}\\x{4C0}-\\x{4C1}\\x{4C3}\\x{4C5}\\x{4C7}\\x{4C9}\\x{4CB}\\x{4CD}\\x{4D0}\\x{4D2}\\x{4D4}\\x{4D6}\\x{4D8}\\x{4DA}\\x{4DC}\\x{4DE}\\x{4E0}\\x{4E2}\\x{4E4}\\x{4E6}\\x{4E8}\\x{4EA}\\x{4EC}\\x{4EE}\\x{4F0}\\x{4F2}\\x{4F4}\\x{4F6}\\x{4F8}\\x{4FA}\\x{4FC}\\x{4FE}\\x{500}\\x{502}\\x{504}\\x{506}\\x{508}\\x{50A}\\x{50C}\\x{50E}\\x{510}\\x{512}\\x{514}\\x{516}\\x{518}\\x{51A}\\x{51C}\\x{51E}\\x{520}\\x{522}\\x{524}\\x{526}\\x{528}\\x{52A}\\x{52C}\\x{52E}\\x{531}-\\x{556}\\x{587}\\x{10A0}-\\x{10AD}].*')
        && !key.matches('(?s).*[\\x{10AE}-\\x{10C5}\\x{10C7}\\x{10CD}\\x{13F8}-\\x{13FD}\\x{1C80}-\\x{1C89}\\x{1C90}-\\x{1CBA}\\x{1CBD}-\\x{1CBF}\\x{1E00}\\x{1E02}\\x{1E04}\\x{1E06}\\x{1E08}\\x{1E0A}\\x{1E0C}\\x{1E0E}\\x{1E10}\\x{1E12}\\x{1E14}\\x{1E16}\\x{1E18}\\x{1E1A}\\x{1E1C}\\x{1E1E}\\x{1E20}\\x{1E22}\\x{1E24}\\x{1E26}\\x{1E28}\\x{1E2A}\\x{1E2C}\\x{1E2E}\\x{1E30}\\x{1E32}\\x{1E34}\\x{1E36}\\x{1E38}\\x{1E3A}\\x{1E3C}\\x{1E3E}\\x{1E40}\\x{1E42}\\x{1E44}\\x{1E46}\\x{1E48}\\x{1E4A}\\x{1E4C}\\x{1E4E}\\x{1E50}\\x{1E52}\\x{1E54}\\x{1E56}\\x{1E58}\\x{1E5A}\\x{1E5C}\\x{1E5E}\\x{1E60}\\x{1E62}\\x{1E64}\\x{1E66}\\x{1E68}\\x{1E6A}\\x{1E6C}\\x{1E6E}\\x{1E70}\\x{1E72}\\x{1E74}\\x{1E76}\\x{1E78}\\x{1E7A}\\x{1E7C}\\x{1E7E}\\x{1E80}\\x{1E82}\\x{1E84}\\x{1E86}\\x{1E88}\\x{1E8A}\\x{1E8C}\\x{1E8E}\\x{1E90}\\x{1E92}\\x{1E94}\\x{1E96}-\\x{1E9B}\\x{1E9E}\\x{1EA0}\\x{1EA2}\\x{1EA4}\\x{1EA6}\\x{1EA8}\\x{1EAA}\\x{1EAC}\\x{1EAE}\\x{1EB0}\\x{1EB2}\\x{1EB4}\\x{1EB6}\\x{1EB8}\\x{1EBA}\\x{1EBC}\\x{1EBE}\\x{1EC0}\\x{1EC2}\\x{1EC4}\\x{1EC6}\\x{1EC8}\\x{1ECA}\\x{1ECC}\\x{1ECE}\\x{1ED0}\\x{1ED2}\\x{1ED4}\\x{1ED6}\\x{1ED8}\\x{1EDA}\\x{1EDC}\\x{1EDE}\\x{1EE0}\\x{1EE2}\\x{1EE4}\\x{1EE6}\\x{1EE8}\\x{1EEA}\\x{1EEC}\\x{1EEE}\\x{1EF0}\\x{1EF2}\\x{1EF4}\\x{1EF6}\\x{1EF8}\\x{1EFA}\\x{1EFC}\\x{1EFE}\\x{1F08}-\\x{1F0F}\\x{1F18}-\\x{1F1D}\\x{1F28}-\\x{1F2F}\\x{1F38}-\\x{1F3F}\\x{1F48}-\\x{1F4D}\\x{1F50}\\x{1F52}\\x{1F54}\\x{1F56}\\x{1F59}\\x{1F5B}\\x{1F5D}\\x{1F5F}\\x{1F68}-\\x{1F6F}\\x{1F80}-\\x{1FAF}\\x{1FB2}-\\x{1FB4}\\x{1FB6}-\\x{1FBC}\\x{1FBE}\\x{1FC2}-\\x{1FC4}\\x{1FC6}-\\x{1FCC}\\x{1FD2}-\\x{1FD3}\\x{1FD6}-\\x{1FDB}\\x{1FE2}-\\x{1FE4}\\x{1FE6}-\\x{1FEC}\\x{1FF2}-\\x{1FF4}\\x{1FF6}-\\x{1FFC}\\x{2126}\\x{212A}-\\x{212B}\\x{2132}\\x{2160}-\\x{216F}\\x{2183}\\x{24B6}-\\x{24CF}\\x{2C00}-\\x{2C2F}\\x{2C60}\\x{2C62}-\\x{2C64}\\x{2C67}\\x{2C69}\\x{2C6B}\\x{2C6D}-\\x{2C70}\\x{2C72}\\x{2C75}\\x{2C7E}-\\x{2C80}\\x{2C82}\\x{2C84}\\x{2C86}\\x{2C88}\\x{2C8A}\\x{2C8C}\\x{2C8E}\\x{2C90}\\x{2C92}\\x{2C94}\\x{2C96}\\x{2C98}\\x{2C9A}\\x{2C9C}\\x{2C9E}\\x{2CA0}\\x{2CA2}\\x{2CA4}\\x{2CA6}\\x{2CA8}\\x{2CAA}\\x{2CAC}].*')
        && !key.matches('(?s).*[\\x{2CAE}\\x{2CB0}\\x{2CB2}\\x{2CB4}\\x{2CB6}\\x{2CB8}\\x{2CBA}\\x{2CBC}\\x{2CBE}\\x{2CC0}\\x{2CC2}\\x{2CC4}\\x{2CC6}\\x{2CC8}\\x{2CCA}\\x{2CCC}\\x{2CCE}\\x{2CD0}\\x{2CD2}\\x{2CD4}\\x{2CD6}\\x{2CD8}\\x{2CDA}\\x{2CDC}\\x{2CDE}\\x{2CE0}\\x{2CE2}\\x{2CEB}\\x{2CED}\\x{2CF2}\\x{A640}\\x{A642}\\x{A644}\\x{A646}\\x{A648}\\x{A64A}\\x{A64C}\\x{A64E}\\x{A650}\\x{A652}\\x{A654}\\x{A656}\\x{A658}\\x{A65A}\\x{A65C}\\x{A65E}\\x{A660}\\x{A662}\\x{A664}\\x{A666}\\x{A668}\\x{A66A}\\x{A66C}\\x{A680}\\x{A682}\\x{A684}\\x{A686}\\x{A688}\\x{A68A}\\x{A68C}\\x{A68E}\\x{A690}\\x{A692}\\x{A694}\\x{A696}\\x{A698}\\x{A69A}\\x{A722}\\x{A724}\\x{A726}\\x{A728}\\x{A72A}\\x{A72C}\\x{A72E}\\x{A732}\\x{A734}\\x{A736}\\x{A738}\\x{A73A}\\x{A73C}\\x{A73E}\\x{A740}\\x{A742}\\x{A744}\\x{A746}\\x{A748}\\x{A74A}\\x{A74C}\\x{A74E}\\x{A750}\\x{A752}\\x{A754}\\x{A756}\\x{A758}\\x{A75A}\\x{A75C}\\x{A75E}\\x{A760}\\x{A762}\\x{A764}\\x{A766}\\x{A768}\\x{A76A}\\x{A76C}\\x{A76E}\\x{A779}\\x{A77B}\\x{A77D}-\\x{A77E}\\x{A780}\\x{A782}\\x{A784}\\x{A786}\\x{A78B}\\x{A78D}\\x{A790}\\x{A792}\\x{A796}\\x{A798}\\x{A79A}\\x{A79C}\\x{A79E}\\x{A7A0}\\x{A7A2}\\x{A7A4}\\x{A7A6}\\x{A7A8}\\x{A7AA}-\\x{A7AE}\\x{A7B0}-\\x{A7B4}\\x{A7B6}\\x{A7B8}\\x{A7BA}\\x{A7BC}\\x{A7BE}\\x{A7C0}\\x{A7C2}\\x{A7C4}-\\x{A7C7}\\x{A7C9}\\x{A7CB}-\\x{A7CC}\\x{A7CE}\\x{A7D0}\\x{A7D2}\\x{A7D4}\\x{A7D6}\\x{A7D8}\\x{A7DA}\\x{A7DC}\\x{A7F5}\\x{AB70}-\\x{ABBF}\\x{FB00}-\\x{FB06}\\x{FB13}-\\x{FB17}\\x{FF21}-\\x{FF3A}\\x{10400}-\\x{10427}\\x{104B0}-\\x{104D3}\\x{10570}-\\x{1057A}\\x{1057C}-\\x{1058A}\\x{1058C}-\\x{10592}\\x{10594}-\\x{10595}\\x{10C80}-\\x{10CB2}\\x{10D50}-\\x{10D65}\\x{118A0}-\\x{118BF}\\x{16E40}-\\x{16E45}].*')
        && !key.matches('(?s).*[\\x{16E46}-\\x{16E5F}\\x{16EA0}-\\x{16EB8}\\x{1E900}-\\x{1E921}].*')
        && expandFullFolds(trimName(name)).matches('(?i)\\Q' + key + '\\E');
    }

    function validRecipeKey(data, recipeId) {
      let key = 'nameKey' in data ? data.nameKey : legacyNameKey(data.name);
      return validNameKey(data.name, key)
        && recipeId == hash(data.userId) + '_' + hash(key);
    }

    function ownId(recipeId) {
      return recipeId.matches(hash(request.auth.uid) + '_[0-9a-f]{64}');
    }
    function validRecipeFields(data, recipeId) {
      return data.keys().hasAll([
          'id', 'userId', 'name', 'category', 'difficulty', 'cookTime',
          'favorite', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'name', 'category', 'difficulty', 'cookTime',
          'servings', 'favorite', 'notes', 'createdAt', 'nameKey'
        ])
        && data.id == recipeId && data.userId == request.auth.uid
        && data.name is string && trimName(data.name).size() > 0
        && data.name.matches('(?s).{1,80}')
        && data.category in ['Breakfast', 'Lunch', 'Dinner', 'Dessert']
        && data.difficulty in ['Easy', 'Medium', 'Hard']
        && data.cookTime is int && data.cookTime >= 1 && data.cookTime <= 600
        && (!('servings' in data) ||
          (data.servings is int && data.servings >= 1 && data.servings <= 20))
        && data.favorite is bool
        && (!('notes' in data) || (data.notes is string && data.notes.matches('(?s).{0,300}')))
        && data.createdAt is timestamp && data.createdAt <= request.time;
    }

    match /recipes/{recipeId} {
      // An add or rename transaction can read a missing path in its own namespace.
      allow get: if signedIn() && ownId(recipeId)
        && (!exists(/databases/$(database)/documents/recipes/$(recipeId))
          || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && validRecipeFields(request.resource.data, recipeId)
        && validRecipeKey(request.resource.data, recipeId);
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && validRecipeFields(request.resource.data, recipeId)
        && (validRecipeKey(request.resource.data, recipeId)
          || (!('nameKey' in resource.data) && !('nameKey' in request.resource.data)
            && request.resource.data.name == resource.data.name))
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
