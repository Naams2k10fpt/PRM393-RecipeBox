rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hash(value) {
      return hashing.sha256(value).toHexString().lower();
    }
    function canonicalId(data) {
      return hash(data.userId) + '_' + hash(normalized(data.name));
    }
    // Rules lower() folds ASCII only; explicitly cover Vietnamese and Latin-1.
    function normalized(value) {
      return value.trim().lower()
        .replace('À', 'à')
        .replace('Á', 'á')
        .replace('Â', 'â')
        .replace('Ã', 'ã')
        .replace('Ä', 'ä')
        .replace('Å', 'å')
        .replace('Æ', 'æ')
        .replace('Ç', 'ç')
        .replace('È', 'è')
        .replace('É', 'é')
        .replace('Ê', 'ê')
        .replace('Ë', 'ë')
        .replace('Ì', 'ì')
        .replace('Í', 'í')
        .replace('Î', 'î')
        .replace('Ï', 'ï')
        .replace('Ð', 'ð')
        .replace('Ñ', 'ñ')
        .replace('Ò', 'ò')
        .replace('Ó', 'ó')
        .replace('Ô', 'ô')
        .replace('Õ', 'õ')
        .replace('Ö', 'ö')
        .replace('Ø', 'ø')
        .replace('Ù', 'ù')
        .replace('Ú', 'ú')
        .replace('Û', 'û')
        .replace('Ü', 'ü')
        .replace('Ý', 'ý')
        .replace('Þ', 'þ')
        .replace('Ă', 'ă')
        .replace('Đ', 'đ')
        .replace('Ĩ', 'ĩ')
        .replace('Ũ', 'ũ')
        .replace('Ơ', 'ơ')
        .replace('Ư', 'ư')
        .replace('Ÿ', 'ÿ')
        .replace('Ạ', 'ạ')
        .replace('Ả', 'ả')
        .replace('Ấ', 'ấ')
        .replace('Ầ', 'ầ')
        .replace('Ẩ', 'ẩ')
        .replace('Ẫ', 'ẫ')
        .replace('Ậ', 'ậ')
        .replace('Ắ', 'ắ')
        .replace('Ằ', 'ằ')
        .replace('Ẳ', 'ẳ')
        .replace('Ẵ', 'ẵ')
        .replace('Ặ', 'ặ')
        .replace('Ẹ', 'ẹ')
        .replace('Ẻ', 'ẻ')
        .replace('Ẽ', 'ẽ')
        .replace('Ế', 'ế')
        .replace('Ề', 'ề')
        .replace('Ể', 'ể')
        .replace('Ễ', 'ễ')
        .replace('Ệ', 'ệ')
        .replace('Ỉ', 'ỉ')
        .replace('Ị', 'ị')
        .replace('Ọ', 'ọ')
        .replace('Ỏ', 'ỏ')
        .replace('Ố', 'ố')
        .replace('Ồ', 'ồ')
        .replace('Ổ', 'ổ')
        .replace('Ỗ', 'ỗ')
        .replace('Ộ', 'ộ')
        .replace('Ớ', 'ớ')
        .replace('Ờ', 'ờ')
        .replace('Ở', 'ở')
        .replace('Ỡ', 'ỡ')
        .replace('Ợ', 'ợ')
        .replace('Ụ', 'ụ')
        .replace('Ủ', 'ủ')
        .replace('Ứ', 'ứ')
        .replace('Ừ', 'ừ')
        .replace('Ử', 'ử')
        .replace('Ữ', 'ữ')
        .replace('Ự', 'ự')
        .replace('Ỳ', 'ỳ')
        .replace('Ỵ', 'ỵ')
        .replace('Ỷ', 'ỷ')
        .replace('Ỹ', 'ỹ');
    }

    function ownId(recipeId) {
      return recipeId.matches(hash(request.auth.uid) + '_[0-9a-f]{64}');
    }
    function validRecipe(data, recipeId) {
      return data.keys().hasAll([
          'id', 'userId', 'name', 'category', 'difficulty', 'cookTime',
          'favorite', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'name', 'category', 'difficulty', 'cookTime',
          'servings', 'favorite', 'notes', 'createdAt'
        ])
        && data.id == recipeId && data.userId == request.auth.uid
        && data.name is string && data.name.trim().size() > 0
        && data.name.size() <= 80
        && data.category in ['Breakfast', 'Lunch', 'Dinner', 'Dessert']
        && data.difficulty in ['Easy', 'Medium', 'Hard']
        && data.cookTime is int && data.cookTime >= 1 && data.cookTime <= 600
        && (!('servings' in data) ||
          (data.servings is int && data.servings >= 1 && data.servings <= 20))
        && data.favorite is bool
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300))
        && data.createdAt is timestamp && data.createdAt <= request.time
        && recipeId == canonicalId(data);
    }

    match /recipes/{recipeId} {
      // An add or rename transaction can read a missing path in its own namespace.
      allow get: if signedIn() && ownId(recipeId)
        && (!exists(/databases/$(database)/documents/recipes/$(recipeId))
          || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && validRecipe(request.resource.data, recipeId);
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && validRecipe(request.resource.data, recipeId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
